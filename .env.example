# Public configuration only. Never place a private key in a VITE_ variable.
VITE_CONTRACT_ADDRESS=
VITE_GENLAYER_RPC_URL=/genlayer-rpc
VITE_EVM_RPC_URL=https://studio.genlayer.com/api

# Deployment scripts discover secrets from this project first, then the
# authorized parent knowledge-root .env. Keep real values in ignored .env files.
STUDIONET_PRIVATE_KEY=
STUDIONET_INTEGRATOR_PRIVATE_KEY=
